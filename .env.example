# Frontend: URL of the deployed Flask API (leave blank to use the same host).
REACT_APP_API_URL=http://localhost:5000

# Backend only — never commit the real values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
ADMIN_USERNAME=owner
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_TOKEN_SECRET=use-a-long-random-secret
FRONTEND_URLS=http://localhost:3000,https://abhinavpillai.netlify.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
